---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
				max-height: 40vh;
				width: auto;
				max-width: 100%;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: #c8b8b7;
			}
			.prose {
				columns: 2;
				column-gap: 0.75rem;
			}
			.prose p:not(:has(> img)),
			.prose .title,
			.prose hr,
			.prose h1, .prose h2, .prose h3,
			.prose ul, .prose ol {
				column-span: all;
			}
			.prose p:has(> img:only-child) {
				break-inside: avoid;
				margin: 0 0 0.75rem 0;
			}
			.prose p:has(> img:only-child) img {
				width: 100%;
				height: auto;
				display: block;
				border-radius: 8px;
				cursor: zoom-in;
			}
			@media (max-width: 720px) {
				.prose {
					columns: 1;
				}
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: #c8b8b7;
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
		<style is:global>
			.slideshow {
				column-span: all;
				position: relative;
				margin: 0 auto 1rem;
			}
			.slideshow .slides img {
				display: none;
				width: 100%;
				height: auto;
				border-radius: 8px;
				cursor: zoom-in;
				background: #fff;
			}
			.slideshow .slides img.active {
				display: block;
			}
			.slideshow .ss-prev,
			.slideshow .ss-next {
				position: absolute;
				top: 50%;
				transform: translateY(-50%);
				border: none;
				background: rgba(0, 0, 0, 0.55);
				color: #fff;
				font-size: 1.5rem;
				line-height: 1;
				width: 2.2rem;
				height: 2.2rem;
				border-radius: 50%;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.slideshow .ss-prev { left: 0.5rem; }
			.slideshow .ss-next { right: 0.5rem; }
			.slideshow .ss-prev:hover,
			.slideshow .ss-next:hover {
				background: rgba(0, 0, 0, 0.8);
			}
			.slideshow .ss-dots {
				display: flex;
				gap: 0.4rem;
				justify-content: center;
				margin-top: 0.6rem;
			}
			.slideshow .ss-dot {
				width: 0.6rem;
				height: 0.6rem;
				padding: 0;
				border: none;
				border-radius: 50%;
				background: #6b5b5a;
				cursor: pointer;
			}
			.slideshow .ss-dot.active {
				background: #c8b8b7;
			}
			.slideshow .ss-count {
				text-align: center;
				color: #c8b8b7;
				font-size: 0.85rem;
				margin-top: 0.3rem;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <img width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />

	<div id="lightbox" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.9); z-index:1000; cursor:zoom-out; align-items:center; justify-content:center;">
		<img id="lightbox-img" src="" alt="" style="max-width:90vw; max-height:90vh; border-radius:8px; object-fit:contain;" />
	</div>

	<script>
		const lightbox = document.getElementById('lightbox') as HTMLElement;
		const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;

		document.querySelectorAll('.prose img').forEach((img) => {
			(img as HTMLImageElement).loading = 'lazy';
			(img as HTMLElement).addEventListener('click', () => {
				lightboxImg.src = (img as HTMLImageElement).src;
				lightbox.style.display = 'flex';
				document.body.style.overflow = 'hidden';
			});
		});

		lightbox.addEventListener('click', () => {
			lightbox.style.display = 'none';
			document.body.style.overflow = '';
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				lightbox.style.display = 'none';
				document.body.style.overflow = '';
			}
		});

		document.querySelectorAll('.slideshow').forEach((ss) => {
			const imgs = Array.from(ss.querySelectorAll('.slides img'));
			if (!imgs.length) return;
			const dotsWrap = ss.querySelector('.ss-dots');
			const curEl = ss.querySelector('.ss-cur');
			const totalEl = ss.querySelector('.ss-total');
			if (totalEl) totalEl.textContent = String(imgs.length);
			let idx = imgs.findIndex((im) => im.classList.contains('active'));
			if (idx < 0) idx = 0;

			const show = (n: number) => {
				idx = (n + imgs.length) % imgs.length;
				imgs.forEach((im, k) => im.classList.toggle('active', k === idx));
				dots.forEach((d, k) => d.classList.toggle('active', k === idx));
				if (curEl) curEl.textContent = String(idx + 1);
			};

			const dots = imgs.map((_, n) => {
				const d = document.createElement('button');
				d.type = 'button';
				d.className = 'ss-dot';
				d.setAttribute('aria-label', 'Go to slide ' + (n + 1));
				d.addEventListener('click', () => show(n));
				if (dotsWrap) dotsWrap.appendChild(d);
				return d;
			});

			const prev = ss.querySelector('.ss-prev');
			const next = ss.querySelector('.ss-next');
			if (prev) prev.addEventListener('click', () => show(idx - 1));
			if (next) next.addEventListener('click', () => show(idx + 1));

			document.addEventListener('keydown', (e) => {
				if (lightbox.style.display === 'flex') return;
				if (e.key === 'ArrowLeft') show(idx - 1);
				else if (e.key === 'ArrowRight') show(idx + 1);
			});

			show(idx);
		});
	</script>

	</body>
</html>
