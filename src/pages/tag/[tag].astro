---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import { PROJECT_TAGS } from '../../content.config';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
	const slugify = (t: string) => t.toLowerCase().replace(/\s+/g, '-');
	return PROJECT_TAGS.map((tag) => ({
		params: { tag: slugify(tag) },
		props: { tag },
	}));
}

interface Props {
	tag: (typeof PROJECT_TAGS)[number];
}

const { tag } = Astro.props;

const posts = (await getCollection('blog'))
	.filter((p) => (p.data.tags ?? []).includes(tag))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = `#${tag.replace(/\s+/g, '')} - ${SITE_TITLE}`;
const description = `Projects tagged ${tag}.`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			@keyframes fadeIn {
				from { opacity: 0; transform: translateY(12px); }
				to { opacity: 1; transform: translateY(0); }
			}
			main {
				width: 100%;
				max-width: 1400px;
				animation: fadeIn 0.6s ease-out both;
			}
			.crumb {
				margin: 0 0 0.5rem 0;
				color: #c8b8b7;
			}
			.crumb a { color: #c47a77; }
			h1.tag-title {
				margin: 0 0 0.4em 0;
			}
			h1.tag-title[data-tag="Lighting"]            { color: #e8b64a; }
			h1.tag-title[data-tag="Technical Direction"] { color: #6ec4d8; }
			h1.tag-title[data-tag="Scenic"]              { color: #88c87a; }
			h1.tag-title[data-tag="Photography"]         { color: #c49bea; }
			.lede {
				margin: 0 0 1.5rem 0;
				color: #c8b8b7;
			}
			.empty {
				color: #a89898;
				font-style: italic;
				padding: 2em 0;
			}
			ul.grid {
				--row-h: 280px;
				--gap: 1rem;
				display: flex;
				flex-wrap: wrap;
				gap: var(--gap);
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul.grid li {
				--ar: 1.5;
				flex-grow: var(--ar);
				flex-basis: calc(var(--ar) * var(--row-h));
				min-width: 0;
				display: flex;
				flex-direction: column;
			}
			ul.grid li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul.grid li a {
				display: flex;
				flex-direction: column;
				height: 100%;
			}
			ul.grid li img {
				width: 100%;
				height: auto;
				aspect-ratio: var(--ar);
				object-fit: cover;
				margin-bottom: 0.5rem;
				border-radius: 12px;
				display: block;
			}
			.title {
				margin: 0;
				color: #f0e8e7;
				line-height: 1.1;
			}
			.date {
				margin: 0.1rem 0;
				color: #c8b8b7;
				font-size: 0.9em;
			}
			.desc {
				margin: 0.1rem 0 0.3rem 0;
				color: #a89898;
				font-size: 0.9em;
				line-height: 1.3;
			}
			ul.grid a:hover img {
				box-shadow: var(--box-shadow);
			}
			ul.grid li a:hover h4,
			ul.grid li a:hover .date,
			ul.grid li a:hover .desc {
				color: rgb(var(--accent));
			}
			@media (max-width: 720px) {
				ul.grid {
					--row-h: 220px;
					gap: 0.75rem;
				}
				ul.grid li {
					flex-basis: 100%;
					text-align: center;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<p class="crumb"><a href="/">← All projects</a></p>
				<h1 class="tag-title" data-tag={tag}>#{tag.replace(/\s+/g, '')}</h1>
				<p class="lede">
					{posts.length === 0
						? `No projects tagged ${tag} yet.`
						: `${posts.length} project${posts.length === 1 ? '' : 's'} tagged ${tag}.`}
				</p>

				{posts.length === 0 ? (
					<p class="empty">Check back soon.</p>
				) : (
					<ul class="grid" id="post-grid">
						{posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<img src={post.data.heroImage} alt={post.data.title} loading="lazy" decoding="async" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									{post.data.description && (
										<p class="desc">{post.data.description}</p>
									)}
								</a>
							</li>
						))}
					</ul>
				)}
			</section>
		</main>
		<Footer />

		<script is:inline>
			(function () {
				const items = document.querySelectorAll('#post-grid li');
				items.forEach((li) => {
					const img = li.querySelector('img');
					if (!img) return;
					const apply = () => {
						const w = img.naturalWidth, h = img.naturalHeight;
						if (!w || !h) return;
						li.style.setProperty('--ar', (w / h).toFixed(4));
					};
					if (img.complete && img.naturalWidth) apply();
					else img.addEventListener('load', apply, { once: true });
				});
			})();
		</script>
	</body>
</html>
