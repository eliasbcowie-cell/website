---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import { PROJECT_TAGS } from '../content.config';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			@keyframes fadeIn {
				from { opacity: 0; transform: translateY(12px); }
				to { opacity: 1; transform: translateY(0); }
			}
			main {
				width: 100%;
				max-width: 1400px;
				animation: fadeIn 0.6s ease-out both;
			}
			.intro-heading {
				margin-bottom: 0.5rem;
			}
			.intro {
				margin-top: 0;
				margin-bottom: 1.5rem;
				color: #c8b8b7;
			}
			.filter-row {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin: 0 0 1.5rem 0;
				padding: 0;
				list-style: none;
			}
			.filter-chip {
				font: inherit;
				color: #f0e8e7;
				background: rgba(255, 255, 255, 0.06);
				border: 1px solid rgba(255, 255, 255, 0.15);
				padding: 0.3rem 0.8rem;
				border-radius: 999px;
				cursor: pointer;
				transition: 0.2s ease;
			}
			/* Per-tag palette. Dim versions become the chip background,
			   the bold version is used when the chip is active/hovered. */
			.filter-chip[data-tag="Lighting"]            { background: rgba(201, 148, 31, 0.22);  border-color: rgba(201, 148, 31, 0.5); }
			.filter-chip[data-tag="Technical Direction"] { background: rgba(58, 148, 170, 0.22);  border-color: rgba(58, 148, 170, 0.5); }
			.filter-chip[data-tag="Scenic"]              { background: rgba(94, 158, 76, 0.22);   border-color: rgba(94, 158, 76, 0.5); }
			.filter-chip[data-tag="Photography"]         { background: rgba(154, 102, 196, 0.22); border-color: rgba(154, 102, 196, 0.5); }

			.filter-chip:hover {
				filter: brightness(1.25);
				color: #fff;
			}
			.filter-chip.active {
				background: rgb(var(--accent));
				border-color: rgb(var(--accent));
				color: #fff;
			}
			.filter-chip[data-tag="Lighting"].active            { background: #c9941f; border-color: #c9941f; }
			.filter-chip[data-tag="Technical Direction"].active { background: #3a94aa; border-color: #3a94aa; }
			.filter-chip[data-tag="Scenic"].active              { background: #5e9e4c; border-color: #5e9e4c; }
			.filter-chip[data-tag="Photography"].active         { background: #9a66c4; border-color: #9a66c4; }
			/* Justified gallery:
			   - Flex rows that fill the full width (no right-edge gaps).
			   - Each image is sized by its own aspect ratio, so within a row
			     every image shares the same height. */
			ul.grid {
				--row-h: 280px;
				--gap: 1rem;
				display: flex;
				flex-wrap: wrap;
				gap: var(--gap);
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul.grid li {
				--ar: 1.5;
				flex-grow: var(--ar);
				flex-basis: calc(var(--ar) * var(--row-h));
				min-width: 0;
				display: flex;
				flex-direction: column;
			}
			ul.grid li[hidden] { display: none; }
			ul.grid li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul.grid li a {
				display: flex;
				flex-direction: column;
				height: 100%;
			}
			ul.grid li img {
				width: 100%;
				height: auto;
				aspect-ratio: var(--ar);
				object-fit: cover;
				margin-bottom: 0.5rem;
				border-radius: 12px;
				display: block;
			}
			.title {
				margin: 0;
				color: #f0e8e7;
				line-height: 1.1;
			}
			.date {
				margin: 0.1rem 0 0.1rem 0;
				color: #c8b8b7;
				font-size: 0.9em;
			}
			.desc {
				margin: 0.1rem 0 0.3rem 0;
				color: #a89898;
				font-size: 0.9em;
				line-height: 1.3;
			}
			.tags {
				margin: 0;
				padding: 0;
				list-style: none;
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem;
			}
			.tags li {
				color: #f0e8e7;
				font-size: 0.75em;
				letter-spacing: 0.01em;
				padding: 0.15rem 0.55rem;
				border-radius: 999px;
				background: rgba(255, 255, 255, 0.08);
				border: 1px solid rgba(255, 255, 255, 0.12);
			}
			.tags li[data-tag="Lighting"]            { background: rgba(201, 148, 31, 0.28);  border-color: rgba(201, 148, 31, 0.55); }
			.tags li[data-tag="Technical Direction"] { background: rgba(58, 148, 170, 0.28);  border-color: rgba(58, 148, 170, 0.55); }
			.tags li[data-tag="Scenic"]              { background: rgba(94, 158, 76, 0.28);   border-color: rgba(94, 158, 76, 0.55); }
			.tags li[data-tag="Photography"]         { background: rgba(154, 102, 196, 0.28); border-color: rgba(154, 102, 196, 0.55); }
			ul.grid li a:hover h4,
			ul.grid li a:hover .date,
			ul.grid li a:hover .desc {
				color: rgb(var(--accent));
			}
			ul.grid a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul.grid {
					--row-h: 220px;
					gap: 0.75rem;
				}
				ul.grid li {
					flex-basis: 100%;
					text-align: center;
				}
				.tags { justify-content: center; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h2 class="intro-heading">Elias Cowie - Lighting Designer & Technical Director</h2>
				<p class="intro">I'm a lighting designer and technical director based in New England. I recently graduated cum laude from Wheaton College with a BA in Theatre & Dance and Economics, earning the Lillian Hellman Prize in Theatre and Dance. Over the past four years I've worked across lighting, sound, and scenic - both as a designer and TD - while building a close network of collaborators throughout New England and New York. Explore my work below, or reach out directly.</p>

				<ul class="filter-row" id="filter-row" aria-label="Filter projects by discipline">
					<li><button type="button" class="filter-chip active" data-tag="">All</button></li>
					{PROJECT_TAGS.map((tag) => (
						<li><button type="button" class="filter-chip" data-tag={tag}>#{tag.replace(/\s+/g, '')}</button></li>
					))}
				</ul>

				<ul class="grid" id="post-grid">
					{
						posts.map((post) => (
							<li data-tags={(post.data.tags ?? []).join('|')}>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<img src={post.data.heroImage} alt={post.data.title} loading="lazy" decoding="async" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									{post.data.description && (
										<p class="desc">{post.data.description}</p>
									)}
									{post.data.tags && post.data.tags.length > 0 && (
										<ul class="tags">
											{post.data.tags.map((t) => (
												<li data-tag={t}>#{t.replace(/\s+/g, '')}</li>
											))}
										</ul>
									)}
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />

		<script is:inline>
			// 1. After each hero image loads, write its real aspect ratio
			//    onto the surrounding <li>, which drives the justified-row
			//    layout in CSS.
			(function () {
				const items = document.querySelectorAll('#post-grid li');
				items.forEach((li) => {
					const img = li.querySelector('img');
					if (!img) return;
					const apply = () => {
						const w = img.naturalWidth;
						const h = img.naturalHeight;
						if (!w || !h) return;
						li.style.setProperty('--ar', (w / h).toFixed(4));
					};
					if (img.complete && img.naturalWidth) apply();
					else img.addEventListener('load', apply, { once: true });
				});
			})();

			// 2. Tag filter chips.
			(function () {
				const chips = document.querySelectorAll('#filter-row .filter-chip');
				const items = document.querySelectorAll('#post-grid li');
				chips.forEach((chip) => {
					chip.addEventListener('click', () => {
						const tag = chip.getAttribute('data-tag') || '';
						chips.forEach((c) => c.classList.toggle('active', c === chip));
						items.forEach((li) => {
							const tags = (li.getAttribute('data-tags') || '').split('|').filter(Boolean);
							const show = !tag || tags.includes(tag);
							li.hidden = !show;
						});
					});
				});
			})();
		</script>
	</body>
</html>
