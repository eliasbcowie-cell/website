---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			@keyframes fadeIn {
				from { opacity: 0; transform: translateY(12px); }
				to { opacity: 1; transform: translateY(0); }
			}
			main {
				width: 100%;
				max-width: 1400px;
				animation: fadeIn 0.6s ease-out both;
			}
			.intro-heading {
				margin-bottom: 0.5rem;
			}
			.intro {
				margin-top: 0;
				margin-bottom: 2rem;
				color: #c8b8b7;
			}
			/* Justified gallery:
			   - Flex rows that fill the full width (no right-edge gaps).
			   - Each image is sized by its own aspect ratio, so within a
			     row all images share the same height. A portrait next to a
			     landscape ends up narrower-but-taller, giving each tile a
			     visually similar area instead of a huge landscape next to
			     a tiny portrait. */
			ul {
				--row-h: 280px;
				--gap: 1rem;
				display: flex;
				flex-wrap: wrap;
				gap: var(--gap);
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				--ar: 1.5; /* fallback until JS reads naturalWidth/Height */
				flex-grow: var(--ar);
				flex-basis: calc(var(--ar) * var(--row-h));
				min-width: 0;
				display: flex;
				flex-direction: column;
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li a {
				display: flex;
				flex-direction: column;
				height: 100%;
			}
			ul li img {
				width: 100%;
				height: auto;
				aspect-ratio: var(--ar);
				object-fit: cover;
				margin-bottom: 0.5rem;
				border-radius: 12px;
				display: block;
			}
			.title {
				margin: 0;
				color: #f0e8e7;
				line-height: 1.1;
			}
			.date {
				margin: 0;
				color: #c8b8b7;
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					--row-h: 220px;
					gap: 0.75rem;
				}
				ul li {
					/* On narrow screens, one image per row so nothing
					   gets squeezed too small. */
					flex-basis: 100%;
					text-align: center;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h2 class="intro-heading">Elias Cowie - Lighting Designer & Technical Director</h2>
				<p class="intro">I'm a lighting designer and technical director based in New England. I recently graduated cum laude from Wheaton College with a BA in Theatre & Dance and Economics, earning the Lillian Hellman Prize in Theatre and Dance. Over the past four years I've worked across lighting, sound, and scenic - both as a designer and TD - while building a close network of collaborators throughout New England and New York. Explore my work below, or reach out directly.</p>
				<ul id="post-grid">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && <img src={post.data.heroImage} alt="" loading="lazy" />}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />

		<script is:inline>
			// After each hero image loads, set its real aspect ratio on the
			// surrounding <li>. The flex-basis + flex-grow formulas in the
			// stylesheet turn that into a justified-row layout where every
			// image in a row shares the same height.
			(function () {
				const items = document.querySelectorAll('#post-grid li');
				items.forEach((li) => {
					const img = li.querySelector('img');
					if (!img) return;
					const apply = () => {
						const w = img.naturalWidth;
						const h = img.naturalHeight;
						if (!w || !h) return;
						const ar = w / h;
						li.style.setProperty('--ar', ar.toFixed(4));
					};
					if (img.complete && img.naturalWidth) apply();
					else img.addEventListener('load', apply, { once: true });
				});
			})();
		</script>
	</body>
</html>
